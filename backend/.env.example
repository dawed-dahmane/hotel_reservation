# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# Generate each key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
#
# DJANGO_SECRET_KEY signs Django sessions, password-reset tokens and CSRF tokens.
# Required — the server refuses to start without it.
DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret

# JWT_SIGNING_KEY signs access/refresh tokens issued by api.authentication.
# Optional; when empty it falls back to DJANGO_SECRET_KEY. Set it separately so
# rotating one key does not invalidate the other.
JWT_SIGNING_KEY=

# Debug is opt-in. Leave empty/unset in production: tracebacks, SQL and settings
# are then never sent to clients (they still go to the logs).
DEBUG=False

# Required when DEBUG=False. Comma-separated list of hostnames this deployment
# answers for. No wildcards.
DJANGO_ALLOWED_HOSTS=api.example.com

# Set to True only when the app runs behind a TLS-terminating proxy that sets
# X-Forwarded-Proto; otherwise clients could spoof it.
DJANGO_BEHIND_PROXY=False

# Redirect all HTTP traffic to HTTPS. Defaults to True when DEBUG=False.
# Set to False when testing production settings locally over plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds (only used when DEBUG=False). Defaults to one year.
# Set to 0 while validating HTTPS, then raise it.
DJANGO_HSTS_SECONDS=31536000

# Sticky in browsers: only enable once every subdomain is HTTPS-only.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
