# Copy to backend/.env and fill in real values. Never commit backend/.env.
#
# Generate each key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
#
# DJANGO_SECRET_KEY signs Django sessions, password-reset tokens and CSRF tokens.
# Required — the server refuses to start without it.
DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret

# JWT_SIGNING_KEY signs access/refresh tokens issued by api.authentication.
# Optional; when empty it falls back to DJANGO_SECRET_KEY. Set it separately so
# rotating one key does not invalidate the other.
JWT_SIGNING_KEY=

# Set to False in production.
DEBUG=False
